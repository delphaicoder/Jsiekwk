#!/bin/sh
# DepthWallpaper: register the rootless app with LaunchServices.
# IMPORTANT: never restart SpringBoard during package installation.
set +e

APP="/var/jb/Applications/DepthWallpaper.app"
if [ ! -d "$APP" ]; then
    APP="/var/jb/Applications/DepthWallpaperApp.app"
fi
if [ ! -d "$APP" ]; then
    APP="/Applications/DepthWallpaper.app"
fi
if [ ! -d "$APP" ]; then
    APP="/Applications/DepthWallpaperApp.app"
fi

UICACHE=""
if [ -x /var/jb/usr/bin/uicache ]; then
    UICACHE=/var/jb/usr/bin/uicache
elif command -v uicache >/dev/null 2>&1; then
    UICACHE=$(command -v uicache)
fi

# Clean up the broken nested bundle path from older builds, if it exists.
# Theos application targets use INSTALL_PATH as a directory; the app bundle
# name is controlled separately by BUNDLE_NAME.
if [ -d /var/jb/Applications/DepthWallpaper.app/DepthWallpaperApp.app ]; then
    rm -rf /var/jb/Applications/DepthWallpaper.app/DepthWallpaperApp.app
fi

# Register the actual app bundle. Do not restart SpringBoard during installation.
if [ -n "$UICACHE" ] && [ -d "$APP" ] && [ -f "$APP/Info.plist" ]; then
    "$UICACHE" -p "$APP" >/dev/null 2>&1 || "$UICACHE" -a >/dev/null 2>&1
fi

exit 0
